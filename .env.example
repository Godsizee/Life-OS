VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web-Push (VAPID). Public Key ist unkritisch und geht an den Client.
# Private Key NUR serverseitig (M4 Edge Function) nutzen, niemals committen.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_KEYS_JWK als Supabase-Secret (wird von generate-vapid.ts erzeugt, kein lokaler env-Wert)
